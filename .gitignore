# CakePHP specific files #
##########################
/config/app_local.php
/config/.env
/logs/*
/tmp/*
/vendor/*
# Alles, was "secret" im Namen traegt, bleibt draussen — nicht nur die eine
# Datei: es liegen dort auch Sicherungskopien (02-secret.yaml.bak.*) und lose
# Token-Dateien (mytime-secret) mit echten Werten.
/k8s/*secret*
# ... ausser den Vorlagen: die gehoeren ins Repo und tragen nie echte Werte.
!/k8s/*.example.yaml
/*.sql
/hetznerk8sconfig

